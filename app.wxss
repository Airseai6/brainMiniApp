page {
  background: #0b0f19;
  color: #e8edf7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  background: radial-gradient(circle at 20% 0%, #16233a 0%, #0b0f19 46%, #0b0f19 100%);
}

game-rules {
  display: block;
  margin-top: auto;
}

.kicker {
  color: #f0a33a;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 52rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #ffffff;
}

.subtitle {
  margin-top: 18rpx;
  color: #8d9ab3;
  font-size: 26rpx;
  line-height: 1.7;
}

.card {
  background: #111827;
  border: 1rpx solid #22304a;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

.btn-primary {
  background: #f0a33a;
  color: #111827;
  border-radius: 18rpx;
  font-weight: 700;
  font-size: 30rpx;
  padding: 24rpx;
  text-align: center;
  border: none;
}

.btn-ghost {
  background: #182235;
  color: #d7e0f0;
  border-radius: 18rpx;
  font-size: 26rpx;
  padding: 22rpx;
  text-align: center;
  border: 1rpx solid #2a3a56;
}

.muted {
  color: #7e8aa3;
  font-size: 24rpx;
  line-height: 1.7;
}
