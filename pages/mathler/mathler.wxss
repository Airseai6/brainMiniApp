@import "../../styles/game.wxss";

.mathler-page { padding-top: 16rpx; }

.input-board {
  display: flex;
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 12rpx;
  background: #0d1420;
  border: 1rpx solid #22304a;
  border-radius: 14rpx;
}
.slot {
  flex: 1;
  min-height: 70rpx;
  border-radius: 8rpx;
  background: #111827;
  border: 1rpx solid #2a3a56;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Consolas, monospace;
  font-size: 30rpx;
  color: #e8edf7;
}
.slot.empty { color: #44536b; }
.slot.op { color: #f0a33a; background: #1b2333; }
.slot.eq { color: #5bd9be; background: #1b2333; }

.keys { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8rpx; margin-top: 12rpx; }
.key {
  min-height: 70rpx;
  border-radius: 10rpx;
  background: #111827;
  border: 1rpx solid #2a3a56;
  color: #e8edf7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-family: Consolas, monospace;
}
.key.wide { font-family: inherit; font-size: 22rpx; }
.key.submit { background: #f0a33a; border-color: #f0a33a; color: #1a1206; font-family: inherit; font-weight: 700; }

.history { margin-top: 12rpx; display: flex; flex-direction: column; gap: 6rpx; }
.guess-row { display: flex; gap: 6rpx; justify-content: center; }
.guess-tile {
  flex: 1;
  max-width: 64rpx;
  height: 54rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Consolas, monospace;
  font-size: 25rpx;
  background: #1c2639;
  color: #c7d2e5;
  border: 1rpx solid #2a3a56;
}
.guess-tile.hit { background: #1f5c45; border-color: #5bd9be; color: #d8fff2; }
.guess-tile.near { background: #5c4a1c; border-color: #f0a33a; color: #ffe6b0; }
.guess-tile.miss { background: #1a2230; color: #6b7a91; }

.answer-line { margin-top: 10rpx; color: #f0a33a; font-size: 23rpx; text-align: center; font-family: Consolas, monospace; }
