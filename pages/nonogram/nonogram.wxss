@import "../../styles/game.wxss";

.nono {
  margin: 14rpx auto 0;
  width: 100%;
  max-width: 620rpx;
  padding: 10rpx;
  background: #0d1420;
  border: 1rpx solid #22304a;
  border-radius: 14rpx;
}

.top-clues { display: flex; align-items: flex-end; gap: 4rpx; }
.corner { width: 74rpx; flex: 0 0 74rpx; }
.col-clue {
  flex: 1;
  min-height: 54rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: #5bd9be;
  font-family: Consolas, monospace;
  font-size: 18rpx;
  line-height: 1.3;
  text-align: center;
  padding-bottom: 4rpx;
}

.row-line { display: flex; gap: 4rpx; margin-top: 4rpx; align-items: center; }
.row-clue {
  width: 74rpx;
  flex: 0 0 74rpx;
  text-align: right;
  padding-right: 8rpx;
  color: #5bd9be;
  font-family: Consolas, monospace;
  font-size: 18rpx;
  line-height: 1.3;
}

.cell {
  flex: 1;
  height: 86rpx;
  border-radius: 8rpx;
  background: #111827;
  border: 1rpx solid #22304a;
}
.cell.on { background: #f0a33a; border-color: #f0a33a; box-shadow: 0 0 10rpx rgba(240, 163, 58, .18); }
.cell.hint { box-shadow: 0 0 0 2rpx #5bd9be inset; }
