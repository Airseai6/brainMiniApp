@import "../../styles/game.wxss";

.nono {
  margin: 14rpx auto 0;
  width: 100%;
  max-width: 620rpx;
  padding: 10rpx;
  background: #0d1420;
  border: 1rpx solid #22304a;
  border-radius: 14rpx;
}

.top-clues { display: flex; align-items: flex-end; gap: 4rpx; }
.corner { width: 74rpx; flex: 0 0 74rpx; }
.col-clue {
  flex: 1;
  min-height: 54rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: #5bd9be;
  font-family: Consolas, monospace;
  font-size: 18rpx;
  line-height: 1.3;
  text-align: center;
  padding-bottom: 4rpx;
}

.row-line { display: flex; gap: 4rpx; margin-top: 4rpx; align-items: center; }
.row-clue {
  width: 74rpx;
  flex: 0 0 74rpx;
  text-align: right;
  padding-right: 8rpx;
  color: #5bd9be;
  font-family: Consolas, monospace;
  font-size: 18rpx;
  line-height: 1.3;
}

.cell {
  flex: 1;
  height: 86rpx;
  border-radius: 8rpx;
  background: #111827;
  border: 1rpx solid #22304a;
}
.nono.done .cell { pointer-events: none; }
.cell.on { background: #f0a33a; border-color: #f0a33a; box-shadow: 0 0 10rpx rgba(240, 163, 58, .18); }
.cell.hint { box-shadow: 0 0 0 2rpx #5bd9be inset; }

.win-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(91, 217, 190, .1);
  border: 1rpx solid rgba(91, 217, 190, .45);
}
.win-icon { font-size: 42rpx; }
.win-copy { flex: 1; }
.win-title { display: block; color: #5bd9be; font-size: 26rpx; font-weight: 700; }
.win-sub { display: block; color: #93a4bd; font-size: 20rpx; margin-top: 3rpx; }
