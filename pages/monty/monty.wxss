@import "../../styles/game.wxss";

.doors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 14rpx; }
.door {
  min-height: 180rpx;
  border-radius: 16rpx;
  background: #111827;
  border: 2rpx solid #2a3a56;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.door.picked { border-color: #f0a33a; background: #2a1f12; }
.door.opened { opacity: .5; }
.door.win { border-color: #5bd9be; background: rgba(91, 217, 190, .1); }
.door.lose { border-color: #f87171; background: rgba(248, 113, 113, .08); }
.door-icon { font-size: 46rpx; line-height: 1; }
.door-label { color: #93a4bd; font-size: 19rpx; }

.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-top: 12rpx; }
.stat { background: #111827; border: 1rpx solid #22304a; border-radius: 10rpx; padding: 8rpx 10rpx; text-align: center; }
.stat b { display: block; color: #f0a33a; font-size: 26rpx; font-family: Consolas, monospace; }
.stat span { display: block; color: #7e8aa3; font-size: 18rpx; }

.result { margin-top: 12rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #111827; border: 1rpx solid #22304a; color: #d7e0f0; font-size: 22rpx; line-height: 1.6; }
