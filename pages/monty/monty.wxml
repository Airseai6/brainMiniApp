<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 14</text>
    <text class="title-badge">概率实验</text>
  </view>
  <view class="title-row">
    <text class="game-title">三门问题</text>
    <text class="title-badge">换不换</text>
  </view>
  <view class="game-lead">一扇门后是车，两扇门后是羊。你选一扇，主持人知道答案，会打开另一扇有羊的门。</view>

  <view class="status-line">
    <text class="status-strong">{{status}}</text>
    <text class="mono">{{phase === 'result' ? '本局结束' : '选门'}}</text>
  </view>

  <view class="doors">
    <view class="door {{item.cls}}" wx:for="{{doors}}" wx:key="index" data-index="{{index}}" bindtap="tapDoor" hover-class="press">
      <text class="door-icon">{{item.icon}}</text>
      <text class="door-label">{{item.label}}</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat"><b>{{total}}</b><span>局数</span></view>
    <view class="stat"><b>{{wins}}</b><span>获胜</span></view>
    <view class="stat"><b>{{rate}}</b><span>胜率</span></view>
  </view>

  <view wx:if="{{phase === 'result' && won}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 概率实验完成</text>
      <text class="win-sub">这一局的选择已揭晓</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-primary" wx:if="{{phase === 'decide'}}" bindtap="switchDoor">换门</view>
    <view class="btn-ghost" wx:if="{{phase === 'decide'}}" bindtap="stayDoor">坚持</view>
    <view class="btn-primary" wx:if="{{phase === 'result'}}" bindtap="again">再来一局</view>
    <view class="btn-ghost" wx:if="{{phase === 'result'}}" bindtap="simulate">模拟 1000 局</view>
  </view>

  <view wx:if="{{resultText}}" class="result">{{resultText}}</view>

  <game-rules title="能学到什么 · 条件概率" text="一开始选中概率 1/3，没选中 2/3。主持人打开一只羊，不会改变原门的 1/3，只是把另一边的 2/3 集中到剩下那扇门。" example="跑 1000 局：坚持原门大约中 **333** 次，换门大约中 **667** 次。" tip="（没看懂没关系，上手玩一下就会了）"></game-rules>
</view>
