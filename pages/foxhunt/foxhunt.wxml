<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 08</text>
    <text class="title-badge">图论</text>
  </view>
  <view class="title-row">
    <text class="game-title">围堵狐狸</text>
    <text class="title-badge">6 路口</text>
  </view>
  <view class="game-lead">你每回合封一个路口，狐狸沿未封的路移动一步；它无路可走你就赢，它踏进洞口就你输。</view>

  <game-rules text="狐狸在最短路树上选对你最不利的方向。封路口就是在删边；你要做的是把它的所有出边都删掉。" example="狐狸在 3 号点、洞口在 6 号点，封住它们之间的**必经点**，就能把路径切断。"></game-rules>

  <view class="status-line">
    <text class="status-strong">{{status}}</text>
    <text class="mono">封路 {{state.moves}}</text>
  </view>

  <view class="nodes">
    <view class="node {{item.blocked ? 'blocked' : ''}} {{item.fox ? 'fox' : ''}} {{item.den ? 'den' : ''}}" wx:for="{{nodes}}" wx:key="id" data-index="{{index}}" bindtap="tapNode" hover-class="press">
      <text class="node-icon">{{item.den ? '🕳️' : (item.fox ? '🦊' : (item.blocked ? '🚧' : '·'))}}</text>
      <text class="node-num">{{item.id}}</text>
    </view>
  </view>

  <view wx:if="{{won}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 围堵成功</text>
      <text class="win-sub">狐狸无路可走</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-ghost" bindtap="showHint">提示</view>
    <view class="btn-primary" bindtap="reset">重开</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>

  


  <game-learn concept="顶点割与追逃" summary="封住必经点，比到处追更有效；最小割对应最大流。"></game-learn>
</view>
