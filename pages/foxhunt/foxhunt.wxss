@import "../../styles/game.wxss";

.nodes {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  justify-items: center;
  margin-top: 16rpx;
}

.node {
  width: 100%;
  max-width: 190rpx;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  background: #111827;
  border: 2rpx solid #2a3a56;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.node.fox { border-color: #f0a33a; background: #2a1f12; box-shadow: 0 0 0 2rpx rgba(240, 163, 58, .16) inset; }
.node.den { border-color: #5bd9be; }
.node.blocked { opacity: .62; border-color: #66748b; }
.node-icon { font-size: 46rpx; line-height: 1; }
.node-num { color: #7e8aa3; font-size: 20rpx; }
