<view class="container game-page duel-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 08</text>
    <text class="title-badge">概率</text>
  </view>
  <view class="title-row">
    <text class="game-title">骰子对决</text>
    <text class="title-badge">5 局</text>
  </view>
  <view class="game-lead">三颗骰子平均点数都是 5，但两两对战胜率互相克制。每局你选一颗，AI 选另一颗，掷出点数比大小。</view>

  <game-rules text="三颗骰子是循环克制的：红骰克蓝骰，蓝骰克黄骰，黄骰克红骰。单看平均分分不出强弱，必须看两两对战的概率分布。每局赢家得 1 分，5 局定胜负。" example="红骰对蓝骰：红骰有 **20/36 ≈ 55.6%** 的概率更大；但蓝骰对黄骰、黄骰对红骰也各约 55.6%。没有“永远最强”的骰子。"></game-rules>

  <view class="scoreboard">
    <text class="score-round">第 {{match.round}} / {{match.maxRounds}} 轮</text>
    <text class="score-main">你 <b>{{match.playerScore}}</b> : {{match.aiScore}} AI</text>
  </view>

  <view class="dice-row">
    <view class="die-card {{selected === item.id ? 'picked' : ''}} {{aiSelected === item.id ? 'ai' : ''}}" wx:for="{{dice}}" wx:key="id" data-id="{{item.id}}" bindtap="pick" hover-class="press">
      <text class="die-name">{{item.name}}</text>
      <view class="faces">
        <text class="face" wx:for="{{item.faces}}" wx:for-item="face" wx:key="index">{{face}}</text>
      </view>
      <text class="die-note">{{selected === item.id ? '你选的' : (aiSelected === item.id ? 'AI 选的' : '点我选它')}}</text>
    </view>
  </view>

  <view class="relation">
    <view class="relation-title">三颗骰子的克制链</view>
    <view class="relation-row"><text class="rel-a">红骰</text><text>胜</text><text class="rel-b">蓝骰</text><text class="rel-p">55.6%</text></view>
    <view class="relation-row"><text class="rel-b">蓝骰</text><text>胜</text><text class="rel-c">黄骰</text><text class="rel-p">55.6%</text></view>
    <view class="relation-row"><text class="rel-c">黄骰</text><text>胜</text><text class="rel-a">红骰</text><text class="rel-p">55.6%</text></view>
  </view>

  <view class="duel-note">AI 会在剩下两颗里随机选一颗。没有永远最强的骰子，只有这一轮你更想避开谁。</view>

  <view class="duel-tip">
    <text class="duel-tip-line">5 局中赢的局数多者获胜，平局不计分。</text>
    <text class="duel-tip-line">三颗骰子的平均点数都是 5，但波动和克制关系不同。</text>
  </view>

  <view wx:if="{{result}}" class="round-result">
    <text class="result-main">{{result}}</text>
    <text class="result-sub">你掷出 {{playerRoll}} · AI 掷出 {{aiRoll}}</text>
  </view>

  <view class="duel-history" wx:if="{{history.length}}">
    <view class="duel-history-row" wx:for="{{history}}" wx:key="index">
      <text class="dh-round">第 {{item.round}} 轮</text>
      <text>{{item.playerDie}} {{item.playerRoll}} vs {{item.aiDie}} {{item.aiRoll}}</text>
      <text class="dh-result {{item.result === '你赢' ? 'win' : ''}}">{{item.result}}</text>
    </view>
  </view>
  <view class="duel-history-empty" wx:else>本轮记录：选一颗骰子后，每局结果会显示在这里。</view>

  <view wx:if="{{won}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 你赢下了这场对决</text>
      <text class="win-sub">最终比分 {{match.playerScore}} : {{match.aiScore}}</text>
    </view>
  </view>
  <view wx:if="{{tie}}" class="hint-box">5 局打平，再来一场分胜负。</view>

  <view class="actions-row">
    <view class="btn-primary" wx:if="{{done}}" bindtap="startOver">再来一局</view>
    <view class="btn-primary" wx:elif="{{match.phase === 'result'}}" bindtap="next">下一轮</view>
    <view class="btn-ghost" wx:else>先选一颗骰子</view>
    <view class="btn-ghost" wx:if="{{done}}" bindtap="startOver">重开</view>
  </view>

  <game-learn concept="非传递概率与期望值" summary="平均分相同，不代表对战胜率相同；概率比较要看完整分布，而不是只看一个平均数。"></game-learn>
</view>
