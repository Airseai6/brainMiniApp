@import "../../styles/game.wxss";

.duel-page { padding-top: 16rpx; }

.scoreboard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #111827;
  border: 1rpx solid #22304a;
}
.score-main { color: #e8edf7; font-size: 30rpx; font-weight: 800; font-family: Consolas, monospace; }
.score-main b { color: #f0a33a; }
.score-round { color: #93a4bd; font-size: 20rpx; }

.dice-row { display: flex; gap: 10rpx; margin-top: 14rpx; }
.die-card {
  flex: 1;
  padding: 10rpx 8rpx;
  border-radius: 14rpx;
  background: #111827;
  border: 2rpx solid #22304a;
  text-align: center;
}
.die-card.picked { border-color: #f0a33a; background: #2a1f12; box-shadow: 0 0 14rpx rgba(240, 163, 58, .18); }
.die-card.ai { border-color: #b79cff; background: #1d1830; }
.die-name { display: block; color: #e8edf7; font-size: 20rpx; font-weight: 700; margin-bottom: 6rpx; }
.die-card.picked .die-name { color: #f0a33a; }
.die-card.ai .die-name { color: #c4b5fd; }
.faces { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rpx; }
.face {
  min-height: 30rpx;
  border-radius: 4rpx;
  background: #0d1420;
  color: #c7d2e5;
  font-family: Consolas, monospace;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.die-note { display: block; color: #7e8aa3; font-size: 17rpx; margin-top: 5rpx; }

.relation {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #111827;
  border: 1rpx solid #22304a;
}
.relation-title { color: #93a4bd; font-size: 19rpx; margin-bottom: 6rpx; }
.relation-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #c7d2e5;
  font-size: 20rpx;
  line-height: 1.8;
}
.rel-a { color: #f08a8a; font-weight: 700; }
.rel-b { color: #8fb8ff; font-weight: 700; }
.rel-c { color: #f0c46a; font-weight: 700; }
.rel-p { margin-left: auto; color: #5bd9be; font-family: Consolas, monospace; font-size: 19rpx; }

.duel-note {
  margin-top: 10rpx;
  color: #7e8aa3;
  font-size: 19rpx;
  line-height: 1.6;
}

.duel-tip {
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(240, 163, 58, .05);
  border: 1rpx solid rgba(240, 163, 58, .14);
}
.duel-tip-line { display: block; color: #b9c4d6; font-size: 19rpx; line-height: 1.7; }

.duel-history-empty {
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
  background: #0d1420;
  border: 1rpx dashed #2a3a56;
  color: #6b7a91;
  font-size: 19rpx;
}

.round-result {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(91, 217, 190, .08);
  border: 1rpx solid rgba(91, 217, 190, .3);
  text-align: center;
}
.result-main { display: block; color: #5bd9be; font-size: 27rpx; font-weight: 700; }
.result-sub { display: block; color: #93a4bd; font-size: 21rpx; margin-top: 4rpx; }

.duel-history { margin-top: 10rpx; }
.duel-history-row {
  display: flex;
  gap: 10rpx;
  align-items: center;
  padding: 7rpx 10rpx;
  border-bottom: 1rpx solid #1b2638;
  color: #8d9ab3;
  font-size: 19rpx;
}
.duel-history-row:last-child { border-bottom: none; }
.dh-round { color: #7e8aa3; width: 90rpx; }
.dh-result { margin-left: auto; color: #93a4bd; }
.dh-result.win { color: #5bd9be; }
