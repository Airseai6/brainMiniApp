@import "../../styles/game.wxss";

.board {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4rpx;
  width: 100%;
  max-width: 560rpx;
  margin: 14rpx auto 0;
  padding: 8rpx;
  background: #0d1420;
  border: 2rpx solid #2a3a56;
  border-radius: 14rpx;
}

.cell {
  aspect-ratio: 1 / 1;
  border-radius: 6rpx;
  background: #111827;
  border: 1rpx solid #22304a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e8edf7;
  font-family: Consolas, monospace;
  font-size: 40rpx;
}

.cell.given { color: #93a4bd; background: #0f172a; font-weight: 700; }
.cell.selected { border-color: #f0a33a; background: #2a1f12; box-shadow: 0 0 0 2rpx rgba(240, 163, 58, .22) inset; }
.cell.hint { color: #5bd9be; border-color: #2f7d5b; }
.cell.wrong { color: #f87171; border-color: #7f2d2d; background: #2a1212; }

.numpad { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; margin-top: 12rpx; }
.num {
  min-height: 72rpx;
  border-radius: 10rpx;
  background: #111827;
  border: 1rpx solid #2a3a56;
  color: #e8edf7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-family: Consolas, monospace;
}
.num.clear { grid-column: span 4; font-size: 22rpx; font-family: inherit; color: #93a4bd; }

.status-pill {
  margin-top: 10rpx;
  color: #93a4bd;
  font-size: 21rpx;
  line-height: 1.6;
}
