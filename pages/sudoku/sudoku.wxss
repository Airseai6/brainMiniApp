@import "../../styles/game.wxss";

.board {
  display: grid;
  gap: 4rpx;
  width: 100%;
  max-width: 560rpx;
  margin: 14rpx auto 0;
  padding: 8rpx;
  background: #0d1420;
  border: 2rpx solid #2a3a56;
  border-radius: 14rpx;
}
.board.s4 { grid-template-columns: repeat(4, 1fr); }
.board.s6 { grid-template-columns: repeat(6, 1fr); max-width: 620rpx; }
.board.s9 { grid-template-columns: repeat(9, 1fr); max-width: 660rpx; gap: 2rpx; }

.cell {
  aspect-ratio: 1 / 1;
  border-radius: 6rpx;
  background: #111827;
  border: 1rpx solid #22304a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e8edf7;
  font-family: Consolas, monospace;
  font-size: 40rpx;
}
.board.s6 .cell { font-size: 30rpx; border-radius: 4rpx; }
.board.s9 .cell { font-size: 21rpx; border-radius: 3rpx; }

.cell.given { color: #93a4bd; background: #0f172a; font-weight: 700; }
.cell.selected { border-color: #f0a33a; background: #2a1f12; box-shadow: 0 0 0 2rpx rgba(240, 163, 58, .22) inset; }
.cell.hint { color: #5bd9be; border-color: #2f7d5b; }
.cell.wrong { color: #f87171; border-color: #7f2d2d; background: #2a1212; }
.cell.edge-r { border-right: 3rpx solid #466085; }
.cell.edge-b { border-bottom: 3rpx solid #466085; }

.numpad { display: grid; gap: 8rpx; margin-top: 12rpx; }
.numpad.n4 { grid-template-columns: repeat(4, 1fr); }
.numpad.n6 { grid-template-columns: repeat(6, 1fr); }
.numpad.n9 { grid-template-columns: repeat(9, 1fr); }
.num {
  min-height: 72rpx;
  border-radius: 10rpx;
  background: #111827;
  border: 1rpx solid #2a3a56;
  color: #e8edf7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-family: Consolas, monospace;
}
.numpad.n6 .num { min-height: 64rpx; font-size: 27rpx; }
.numpad.n9 .num { min-height: 52rpx; font-size: 23rpx; }
.num.clear { grid-column: 1 / -1; font-size: 22rpx; font-family: inherit; color: #93a4bd; }

.status-pill {
  margin-top: 10rpx;
  color: #93a4bd;
  font-size: 21rpx;
  line-height: 1.6;
}
