<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 11</text>
    <text class="title-badge">递归</text>
  </view>
  <view class="title-row">
    <text class="game-title">汉诺塔</text>
    <text class="title-badge">最少步</text>
  </view>
  <view class="game-lead">三根柱子，大盘不能压小盘。把整座塔从 A 搬到 C，最少要 2ⁿ−1 步。</view>

  <game-rules text="把整摞圆盘从起始柱移到目标柱；一次只能移一个圆盘，大盘不能压在小盘上。" example="点一根柱子拿起顶部圆盘，再点目标柱放下。" tip="（没看懂没关系，上手玩一下就会了）"></game-rules>

  <view class="levels">
    <view class="level {{n === 3 ? 'active' : ''}}" data-n="3" bindtap="level">3 层</view>
    <view class="level {{n === 4 ? 'active' : ''}}" data-n="4" bindtap="level">4 层</view>
    <view class="level {{n === 5 ? 'active' : ''}}" data-n="5" bindtap="level">5 层</view>
    <view class="level {{n === 6 ? 'active' : ''}}" data-n="6" bindtap="level">6 层</view>
  </view>

  <view class="status-line">
    <text class="status-strong">步数 {{moves}} / 最少 {{minMoves}}</text>
    <text>{{win ? '完成！' : (selected === -1 ? '点柱子拿起圆盘' : '再点柱子放下')}}</text>
  </view>

  <view class="board">
    <view wx:for="{{pegs}}" wx:key="label" wx:for-item="p" wx:for-index="pi" class="peg {{selected === pi ? 'active' : ''}}" data-index="{{pi}}" bindtap="tapPeg" hover-class="press">
      <view class="rod"></view>
      <view class="disks">
        <view wx:for="{{p.disks}}" wx:key="size" wx:for-item="d" class="disk" style="width: {{d.width}}rpx; background: {{d.size % 2 === 0 ? '#7c6cf0' : '#b49cff'}};">{{d.size}}</view>
      </view>
      <view class="peg-label">{{p.label}}</view>
    </view>
  </view>

  <view wx:if="{{win}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 完成！</text>
      <text class="win-sub">最少步完成汉诺塔</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-primary" bindtap="showHint">提示下一步</view>
    <view class="btn-ghost" bindtap="reset">重来</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>

  


  <game-learn concept="递归与指数增长" summary="T(n)=2T(n−1)+1，T(1)=1，所以 T(n)=2ⁿ−1。每加一层，步数几乎翻倍；这是递归与指数增长。"></game-learn>
</view>
