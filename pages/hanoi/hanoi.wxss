.container {
  min-height: 100vh;
  padding: 32rpx;
  background: radial-gradient(circle at 20% 0%, #16233a 0%, #0b0f19 46%, #0b0f19 100%);
}

.kicker { color: #f0a33a; font-size: 22rpx; letter-spacing: 4rpx; }
.title { color: #fff; font-size: 52rpx; font-weight: 800; margin-top: 12rpx; }
.subtitle { color: #8d9ab3; font-size: 25rpx; line-height: 1.7; margin-top: 14rpx; }

.levels { display: flex; gap: 12rpx; margin-top: 24rpx; }
.level {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 14rpx;
  background: #111827; border: 1rpx solid #22304a; color: #93a4bd; font-size: 23rpx;
}
.level.active { background: #241a33; border-color: #a78bfa; color: #c4b5fd; font-weight: 700; }

.status { display: flex; justify-content: space-between; align-items: baseline; margin-top: 24rpx; }
.status-main { color: #fff; font-size: 28rpx; font-weight: 700; }
.status-tip { color: #7e8aa3; font-size: 21rpx; }

.board {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 22rpx 14rpx;
  background: #111827;
  border: 1rpx solid #22304a;
  border-radius: 24rpx;
}

.peg {
  flex: 1;
  height: 430rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 38rpx;
  border-radius: 18rpx;
}

.peg.active { background: #1b2740; }

.rod {
  position: absolute;
  bottom: 35rpx;
  width: 8rpx;
  height: 330rpx;
  background: #3a4a66;
  border-radius: 4rpx;
}

.disks {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  gap: 5rpx;
  margin-bottom: 4rpx;
}

.disk {
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 8rpx;
  text-align: center;
  color: #1b1033;
  font-size: 19rpx;
  font-weight: 700;
}

.peg-label { position: absolute; bottom: 6rpx; color: #7e8aa3; font-size: 22rpx; }

.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.actions .btn-primary, .actions .btn-ghost { flex: 1; }

.hint {
  margin-top: 22rpx; padding: 20rpx; border-radius: 16rpx;
  background: #0f172a; border: 1rpx solid #24344e;
  color: #c7d2e5; font-size: 24rpx; line-height: 1.8;
}

.rule { margin-top: 28rpx; padding: 24rpx; background: #111827; border-radius: 20rpx; border: 1rpx solid #22304a; }
.rule-title { color: #f0a33a; font-size: 26rpx; font-weight: 700; }
.rule-text { color: #8d9ab3; font-size: 24rpx; line-height: 1.8; margin-top: 10rpx; }
