@import "../../styles/game.wxss";

.levels { display: flex; gap: 10rpx; margin-top: 16rpx; }
.level {
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #111827;
  border: 1rpx solid #22304a;
  color: #93a4bd;
  font-size: 22rpx;
}
.level.active { background: #241a33; border-color: #a78bfa; color: #c4b5fd; font-weight: 700; }

.board {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 14rpx 10rpx;
  background: #111827;
  border: 1rpx solid #22304a;
  border-radius: 20rpx;
}

.peg {
  flex: 1;
  height: 400rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 32rpx;
  border-radius: 14rpx;
}

.peg.active { background: #1b2740; box-shadow: 0 0 0 2rpx rgba(183, 156, 255, .35) inset; }

.rod {
  position: absolute;
  bottom: 30rpx;
  width: 8rpx;
  height: 310rpx;
  background: #3a4a66;
  border-radius: 4rpx;
}

.disks { position: relative; z-index: 2; width: 100%; display: flex; flex-direction: column-reverse; align-items: center; gap: 5rpx; margin-bottom: 2rpx; }
.disk { height: 32rpx; line-height: 32rpx; border-radius: 7rpx; text-align: center; color: #1b1033; font-size: 18rpx; font-weight: 700; }
.peg-label { position: absolute; bottom: 4rpx; color: #7e8aa3; font-size: 21rpx; }
