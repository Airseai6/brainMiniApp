<web-view wx:if="{{url}}" src="{{url}}"></web-view>

<view wx:else class="container">
  <view class="kicker">H5 · 业务域名未配置</view>
  <view class="title">{{game ? game.name : '关卡'}}</view>
  <view class="subtitle">这个完整版是 H5。小程序内打开它，需要先在微信公众平台配置一个已 ICP 备案的「业务域名」，再把 app.js 里的 h5Base 换成该域名。</view>

  <view class="card">
    <view class="row-label">当前状态</view>
    <view class="link">该关卡暂未开放；先玩首页的原生关卡。</view>
    <view class="btn-ghost" bindtap="back">回首页</view>
  </view>

  <view class="muted">完整版需要配置已备案的业务域名后再接入。</view>
</view>
