.container {
  min-height: 100vh;
  padding: 32rpx;
  background: radial-gradient(circle at 20% 0%, #16233a 0%, #0b0f19 46%, #0b0f19 100%);
}
.kicker { color: #f0a33a; font-size: 22rpx; letter-spacing: 4rpx; }
.title { color: #fff; font-size: 52rpx; font-weight: 800; margin-top: 12rpx; }
.subtitle { color: #8d9ab3; font-size: 25rpx; line-height: 1.7; margin-top: 14rpx; }
.card { margin-top: 28rpx; background: #111827; border: 1rpx solid #22304a; border-radius: 22rpx; padding: 26rpx; }
.row-label { color: #7e8aa3; font-size: 22rpx; }
.link { color: #f0a33a; font-size: 23rpx; line-height: 1.7; word-break: break-all; margin-top: 10rpx; }
.btn-primary { margin-top: 22rpx; }
.btn-ghost { margin-top: 14rpx; }
.muted { margin-top: 24rpx; color: #6f7d94; font-size: 23rpx; line-height: 1.8; }
