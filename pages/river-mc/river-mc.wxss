@import "../../styles/game.wxss";

.banks { display: grid; grid-template-columns: 1fr 100rpx 1fr; gap: 8rpx; margin-top: 14rpx; }
.bank { background: #111827; border: 1rpx solid #22304a; border-radius: 14rpx; padding: 12rpx; }
.bank-title { color: #93a4bd; font-size: 20rpx; display: flex; justify-content: space-between; }
.bank-title b { color: #f0a33a; font-family: Consolas, monospace; }
.people { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.person { font-size: 36rpx; line-height: 1; }

.boat-zone { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; color: #f0a33a; font-size: 18rpx; }
.boat-icon { font-size: 40rpx; }

.pick-panel { margin-top: 14rpx; background: #111827; border: 1rpx solid #22304a; border-radius: 14rpx; padding: 12rpx; }
.pick-head { color: #93a4bd; font-size: 20rpx; display: flex; justify-content: space-between; }
.pick-head b { color: #f0a33a; }
.people-pick { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.person-btn {
  min-width: 128rpx;
  min-height: 66rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #0d1420;
  border: 1rpx solid #2a3a56;
  color: #e8edf7;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.person-btn.selected { border-color: #f0a33a; background: #2a1f12; color: #f0a33a; }

.win-note { margin-top: 12rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: rgba(91,217,190,.1); border: 1rpx solid rgba(91,217,190,.4); color: #5bd9be; font-size: 23rpx; line-height: 1.6; }
