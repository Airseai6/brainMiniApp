<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 06B</text>
    <text class="title-badge">挑战关</text>
  </view>
  <view class="title-row">
    <text class="game-title">传教士与野人</text>
    <text class="title-badge">过河第二关</text>
  </view>
  <view class="game-lead">船每次最多坐 2 人，必须有人划船。任意一岸野人多于传教士，传教士就会被吃。</view>

  <view class="seg-row">
    <view class="seg" bindtap="gotoWGC">狼 · 羊 · 菜（入门）</view>
    <view class="seg warm active">传教士 · 野人（挑战）</view>
  </view>

  <view class="status-line">
    <text class="status-strong">{{status}}</text>
    <text class="mono">第 {{state.moves}} 步</text>
  </view>

  <view class="banks">
    <view class="bank">
      <view class="bank-title"><text>出发岸</text><b>{{left.m}}M / {{left.c}}C</b></view>
      <view class="people">
        <text class="person" wx:for="{{leftPeople}}" wx:key="index">{{item}}</text>
      </view>
    </view>
    <view class="boat-zone">
      <text class="boat-icon">⛵</text>
      <text>{{boatSide === 'left' ? '左岸' : '右岸'}}</text>
    </view>
    <view class="bank">
      <view class="bank-title"><text>目标岸</text><b>{{right.m}}M / {{right.c}}C</b></view>
      <view class="people">
        <text class="person" wx:for="{{rightPeople}}" wx:key="index">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="pick-panel">
    <view class="pick-head"><text>选择船上的人（最多 2 人）</text><b>已选 {{selectedCount}}/2</b></view>
    <view class="people-pick">
      <view class="person-btn {{item.selected ? 'selected' : ''}}" wx:for="{{boatPeople}}" wx:key="key" data-index="{{index}}" bindtap="togglePerson" hover-class="press">
        <text>{{item.icon}}</text><text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-primary" bindtap="crossSelected">开船</view>
    <view class="btn-ghost" bindtap="clearSelection">清空</view>
    <view class="btn-ghost" bindtap="reset">重来</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>
  <view wx:if="{{state.won}}" class="win-note">全部安全到达！传教士与野人 11 步经典解完成。</view>

  <view class="rule-box">
    <view class="rule-title">能学到什么 · 状态图与约束</view>
    <view class="rule-text">每一步都要同时满足两岸的安全约束；把“左岸人数 + 船位”看成状态，过河就是状态图上的最短路。经典最短解是 11 步。</view>
  </view>
</view>
