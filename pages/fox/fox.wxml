<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 01</text>
    <text class="title-badge">{{level === 1 ? '路径 P5' : '环 C5'}}</text>
  </view>
  <view class="title-row">
    <text class="game-title">抓狐狸</text>
    <text class="title-badge">2 关</text>
  </view>
  <view class="game-lead">每天查一个洞；你查完，狐狸会沿相邻的洞跑掉。路径上有必胜策略，环上却不一定。</view>

  <game-rules text="路径是一条链，从一端向另一端扫，总能把狐狸逼到端点；环没有端点，奇偶性不匹配时可能永远差一格。半透明狐狸是信息论里的“可能位置集合”。" example="路径 P5 先查 **3 号洞**，狐狸只能往两边跑；再查相邻洞，一步步把它逼到**端点**。"></game-rules>

  <view class="seg-row">
    <view class="seg warm {{level === 1 ? 'active' : ''}}" data-level="1" bindtap="setLevel">路径 · P5</view>
    <view class="seg warm {{level === 2 ? 'active' : ''}}" data-level="2" bindtap="setLevel">环 · C5</view>
  </view>

  <view class="fox-hero {{caught ? 'caught' : (lost ? 'lost' : '')}}">
    <text class="fox-emoji">{{caught ? '🎯' : (lost ? '💨' : '🦊')}}</text>
    <view class="fox-copy">
      <text class="fox-state">{{caught ? '抓到了！' : (lost ? '狐狸跑了' : '狐狸藏在某个洞里')}}</text>
      <text class="fox-sub">{{caught ? '这一关的策略走通了。' : (lost ? '天数用完，再试一次。' : (level === 2 ? '环上首尾相连，仔细看位置。' : '浅色狐狸 = 她可能的位置。'))}}</text>
    </view>
  </view>

  <view class="status-line">
    <text class="status-strong">第 {{state.day}} / {{state.maxDay}} 天</text>
    <text class="mono">已查 {{state.checked.length}} 次</text>
  </view>
  <view class="progress-track">
    <view class="progress-fill" style="width: {{state.day * 100 / state.maxDay}}%;"></view>
  </view>

  <view class="fox-stage {{level === 2 ? 'ring' : 'path'}}">
    <view class="hole {{item.checked ? 'checked' : ''}} {{item.last ? 'last' : ''}} {{item.fox ? 'fox' : ''}} {{item.ghost ? 'ghost' : ''}}" wx:for="{{holes}}" wx:key="label" data-index="{{index}}" bindtap="check" hover-class="press" style="{{item.style}}">
      <text wx:if="{{item.fox}}" class="hole-icon">🦊</text>
      <text wx:elif="{{item.ghost}}" class="hole-ghost">🦊</text>
      <text wx:elif="{{item.checked}}" class="hole-icon">✓</text>
      <text wx:else class="hole-icon">·</text>
      <text class="hole-num">{{item.label}}</text>
    </view>
    <view wx:if="{{level === 2}}" class="ring-center">1 ↔ 5 相连</view>
  </view>

  <view wx:if="{{caught}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 抓到了！</text>
      <text class="win-sub">狐狸落入你排查的洞</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-ghost" bindtap="showHint">提示</view>
    <view class="btn-primary" bindtap="restart">重开</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>

  


  <game-learn concept="图论与奇偶性" summary="路径有端点，环没有；追逃问题先看图的奇偶结构。"></game-learn>
</view>
