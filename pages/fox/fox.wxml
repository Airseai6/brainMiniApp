<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 10</text>
    <text class="title-badge">{{level === 1 ? '路径 P5' : '环 C5'}}</text>
  </view>
  <view class="title-row">
    <text class="game-title">抓狐狸</text>
    <text class="title-badge">2 关</text>
  </view>
  <view class="game-lead">每天查一个洞；你查完，狐狸会沿相邻的洞跑掉。路径上有必胜策略，环上却不一定。</view>

  <game-rules text="每天查一个洞；你查完，狐狸会沿相邻的洞移动。在限定天数内查到它就赢，天数用完则失败。" example="点一个洞查看结果；是空是抓到，都会写进下方排查记录。"></game-rules>

  <view class="seg-row">
    <view class="seg warm {{level === 1 ? 'active' : ''}}" data-level="1" bindtap="setLevel">路径 · P5</view>
    <view class="seg warm {{level === 2 ? 'active' : ''}}" data-level="2" bindtap="setLevel">环 · C5</view>
  </view>

  <view class="status-line">
    <text class="status-strong">{{caught ? '抓到了' : (lost ? '狐狸跑了' : '第 ' + state.day + ' / ' + state.maxDay + ' 天')}}</text>
    <text class="mono">已查 {{history.length}} 次</text>
  </view>

  <view class="fox-stage {{level === 2 ? 'ring' : 'path'}}">
    <view class="hole {{item.latest ? 'latest' : ''}} {{item.fox ? 'fox' : ''}} {{item.ghost ? 'ghost' : ''}}" wx:for="{{holes}}" wx:key="label" data-index="{{index}}" bindtap="check" hover-class="press" style="{{item.style}}">
      <text wx:if="{{item.fox}}" class="hole-icon">🦊</text>
      <text wx:elif="{{item.ghost}}" class="hole-ghost">🦊</text>
      <text wx:else class="hole-dot">{{item.latest ? '●' : '·'}}</text>
      <text class="hole-num">{{item.label}}</text>
      <text wx:if="{{item.latest}}" class="hole-today">今天</text>
    </view>
    <view wx:if="{{level === 2}}" class="ring-center">1 ↔ 5 相连</view>
  </view>

  <view class="fox-legend">
    <text>浅色🦊 = 可能位置</text>
    <text>琥珀 = 今天查的洞</text>
  </view>
  <view class="possible-line">{{possibleText}}</view>

  <view class="fox-log">
    <view class="fox-log-head">
      <text>排查记录</text>
      <text>{{history.length}} / {{state.maxDay}} 天</text>
    </view>
    <view class="fox-log-grid" wx:if="{{history.length}}">
      <view class="fox-log-item" wx:for="{{history}}" wx:key="index">
        <text class="log-day">第 {{item.day}} 天</text>
        <text class="log-hole">查 {{item.hole}} 号洞</text>
        <text class="log-result {{item.result === '抓到' ? 'hit' : ''}}">{{item.result}}</text>
      </view>
    </view>
    <view class="fox-log-empty" wx:else>还没有排查记录，点一个洞开始。</view>
  </view>

  <view wx:if="{{caught}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 抓到了！</text>
      <text class="win-sub">狐狸落入你排查的洞</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-ghost" bindtap="showHint">提示</view>
    <view class="btn-primary" bindtap="restart">重开</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>

  <game-learn concept="图论与奇偶性" summary="路径是一条链，从一端向另一端扫，总能把狐狸逼到端点；环没有端点，奇偶性不匹配时可能永远差一格。浅色狐狸是“可能位置集合”。"></game-learn>
</view>
