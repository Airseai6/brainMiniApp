@import "../../styles/game.wxss";

.fox-hero {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(240, 163, 58, .13), rgba(17, 24, 39, .6));
  border: 1rpx solid rgba(240, 163, 58, .32);
}

.fox-hero.caught { background: rgba(91, 217, 190, .1); border-color: rgba(91, 217, 190, .45); }
.fox-hero.lost { background: rgba(248, 113, 113, .08); border-color: rgba(248, 113, 113, .35); }

.fox-emoji { font-size: 64rpx; line-height: 1; }
.fox-copy { flex: 1; min-width: 0; }
.fox-state { display: block; color: #ffffff; font-size: 30rpx; font-weight: 700; }
.fox-sub { display: block; color: #93a4bd; font-size: 21rpx; margin-top: 5rpx; line-height: 1.5; }

.holes {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}

.hole {
  min-height: 148rpx;
  border-radius: 18rpx;
  background: #111827;
  border: 2rpx solid #2a3a56;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.hole.checked { border-color: #2f7d5b; background: #10231f; }
.hole.last { border-color: #f0a33a; box-shadow: 0 0 0 2rpx rgba(240, 163, 58, .16) inset; }
.hole.fox { border-color: #f0a33a; background: #2a1f12; }
.hole-num { color: #e8edf7; font-size: 28rpx; font-weight: 700; font-family: Consolas, monospace; }
.hole-icon { color: #f0a33a; font-size: 30rpx; line-height: 1; }
.hole.checked .hole-icon { color: #5bd9be; }
.hole.fox .hole-icon { font-size: 42rpx; }

.day-meta { display: flex; align-items: center; gap: 12rpx; }

.progress-track {
  flex: 1;
  height: 8rpx;
  border-radius: 99rpx;
  background: #1b2638;
  overflow: hidden;
}

.progress-fill { height: 100%; background: #f0a33a; border-radius: 99rpx; }

.result-note {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #d7e0f0;
  background: #111827;
  border: 1rpx solid #22304a;
}
