@import "../../styles/game.wxss";

.lights-page { padding-top: 16rpx; }

.lamp-grid {
  display: grid;
  gap: 10rpx;
  width: 100%;
  max-width: 620rpx;
  margin: 16rpx auto 0;
  padding: 14rpx;
  background: #0d1420;
  border: 1rpx solid #22304a;
  border-radius: 20rpx;
}
.lamp-grid.s4 { grid-template-columns: repeat(4, 1fr); }
.lamp-grid.s5 { grid-template-columns: repeat(5, 1fr); }

.lamp {
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  background: #111827;
  border: 2rpx solid #2a3a56;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .16s ease;
}
.lamp.on {
  background: radial-gradient(circle at 45% 38%, #ffd27a 0%, #f0a33a 38%, #7a4a13 100%);
  border-color: #ffd27a;
  box-shadow: 0 0 20rpx rgba(240, 163, 58, .45);
}
.lamp.hint { box-shadow: 0 0 0 3rpx #5bd9be inset, 0 0 18rpx rgba(91, 217, 190, .5); }
.lamp-icon { font-size: 34rpx; opacity: .85; }
.lamp.on .lamp-icon { opacity: 1; }

.hint-line { margin-top: 10rpx; color: #5bd9be; font-size: 22rpx; line-height: 1.6; }
