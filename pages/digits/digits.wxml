<view class="container game-page digits-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 02</text>
    <text class="title-badge">每日一题</text>
  </view>
  <view class="title-row">
    <text class="game-title">数字侦探</text>
    <text class="title-badge">4 位 · 6 次</text>
  </view>
  <view class="game-lead">A = 数字和位置都对，B = 数字对但位置不对。用排除法，不信运气。</view>

  <view class="seg-row">
    <view class="seg {{mode === 'daily' ? 'active' : ''}}" data-mode="daily" bindtap="startDaily">每日挑战</view>
    <view class="seg {{mode === 'practice' ? 'active' : ''}}" data-mode="practice" bindtap="startPractice">随机练习</view>
  </view>
  <view class="seg-row">
    <view class="seg warm {{difficulty === 'normal' ? 'active' : ''}}" data-level="normal" bindtap="setDifficulty">普通 · 不重复</view>
    <view class="seg warm {{difficulty === 'hard' ? 'active' : ''}}" data-level="hard" bindtap="setDifficulty">困难 · 可重复</view>
  </view>

  <view class="status-line">
    <text class="status-strong">{{status}}</text>
    <text class="mono">剩余 {{6 - tries}} 次</text>
  </view>

  <view class="game-panel">
    <view class="panel-label">
      <text wx:if="{{!won && !lost}}">第 {{tries + 1}} 次猜测</text>
      <text wx:else>本局结束</text>
      <text>{{input[0]}}{{input[1]}}{{input[2]}}{{input[3]}}</text>
    </view>
    <view class="slot-row">
      <view class="slot {{item !== '' ? 'filled' : ''}} {{(!won && !lost) && index === activeSlot ? 'active' : ''}}" wx:for="{{input}}" wx:key="index">
        <text class="slot-index">{{index + 1}}</text>
        <text>{{item}}</text>
      </view>
    </view>
    <view class="keypad {{won || lost ? 'disabled' : ''}}">
      <view class="key {{item === '提交' ? 'submit' : ''}}" wx:for="{{keys}}" wx:key="index" data-key="{{item}}" bindtap="press" hover-class="press">{{item}}</view>
    </view>
  </view>

  <view class="history-panel">
    <view class="history-head">
      <text>猜测记录</text>
      <text>已用 {{tries}}/6</text>
    </view>
    <view class="history-grid" wx:if="{{history.length}}">
      <view class="history-row {{index === history.length - 1 ? 'latest' : ''}}" wx:for="{{history}}" wx:key="index">
        <text class="guess">{{item.digits[0]}}{{item.digits[1]}}{{item.digits[2]}}{{item.digits[3]}}</text>
        <text class="fb">{{item.a}}A {{item.b}}B</text>
      </view>
    </view>
    <view class="history-empty" wx:else>还没有猜测，输入 4 位数字。</view>
  </view>

  <view class="actions-row">
    <view class="btn-ghost" bindtap="showHint">看候选数</view>
    <view class="btn-primary" bindtap="newRound">换一题</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>
  <view wx:if="{{won || lost}}" class="answer">
    <text class="answer-label">{{won ? '你找到了' : '正确答案'}}</text>
    <text class="answer-num">{{answer}}</text>
  </view>

  <view class="rule-box">
    <view class="rule-title">为什么是信息论</view>
    <view class="rule-text">普通模式有 5040 个候选。每次反馈都在切掉不可能的分支；6 次足够从 5040 缩到 1。不是猜得准，是排除得对。</view>
  </view>
</view>
