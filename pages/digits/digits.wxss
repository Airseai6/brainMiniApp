@import "../../styles/game.wxss";

.digits-page { padding-top: 16rpx; }

.top-controls {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.mini-tab {
  min-height: 52rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #111827;
  border: 1rpx solid #22304a;
  color: #93a4bd;
  font-size: 20rpx;
  display: flex;
  align-items: center;
}

.mini-tab.active {
  background: #1f2a1f;
  border-color: #5bd9be;
  color: #5bd9be;
  font-weight: 700;
}

.mini-tab.warm.active {
  background: #2a1f12;
  border-color: #f0a33a;
  color: #f0a33a;
}

.mini-split { width: 1rpx; height: 30rpx; background: #2a3a56; margin: 0 2rpx; }

.rules-toggle {
  margin-left: auto;
  color: #7e8aa3;
  font-size: 20rpx;
  padding: 8rpx 4rpx;
}

.rules-lead { margin-top: 10rpx; }

.slot-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin: 4rpx 0 18rpx;
}

.slot {
  min-height: 108rpx;
  border-radius: 16rpx;
  background: #0f172a;
  border: 2rpx solid #2a3a56;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #66748b;
  font-family: Consolas, monospace;
  font-size: 52rpx;
  position: relative;
}

.slot.filled {
  color: #ffffff;
  border-color: #5bd9be;
  background: #10231f;
}

.slot.active {
  border-color: #f0a33a;
  background: #1a1a22;
  box-shadow: 0 0 0 2rpx rgba(240, 163, 58, .28) inset;
}

.slot-index {
  position: absolute;
  top: 8rpx;
  left: 12rpx;
  color: #4d5c70;
  font-size: 17rpx;
  font-family: Consolas, monospace;
}

.keypad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.key {
  min-height: 78rpx;
  border-radius: 14rpx;
  background: #111827;
  border: 1rpx solid #2a3a56;
  color: #e8edf7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Consolas, monospace;
  font-size: 32rpx;
}

.key.submit {
  background: #f0a33a;
  border-color: #f0a33a;
  color: #111827;
  font-family: inherit;
  font-size: 25rpx;
  font-weight: 700;
}

.keypad.disabled .key { opacity: .4; }

.panel-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: #7e8aa3;
  font-size: 21rpx;
}

.history-panel {
  background: #111827;
  border: 1rpx solid #22304a;
  border-radius: 18rpx;
  padding: 14rpx 16rpx;
  margin-top: 14rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  color: #7e8aa3;
  font-size: 21rpx;
  margin-bottom: 10rpx;
}

.history-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 44rpx;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #0d1420;
  border: 1rpx solid #1c2b3f;
}

.history-row.latest {
  border-color: #f0a33a;
  background: #241c12;
}

.history-row .guess {
  color: #e8edf7;
  font-family: Consolas, monospace;
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.history-row .fb {
  color: #f0a33a;
  font-size: 20rpx;
}

.history-empty {
  color: #4d5c70;
  font-size: 21rpx;
  line-height: 44rpx;
}

.answer {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #10231f;
  border: 1rpx solid #2f7d5b;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.answer-label { color: #9fb0c7; font-size: 21rpx; }
.answer-num { color: #5bd9be; font-family: Consolas, monospace; font-size: 40rpx; letter-spacing: 6rpx; }
