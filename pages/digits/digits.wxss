.mode-row, .diff-row { display: flex; gap: 12rpx; margin-top: 20rpx; }
.mode, .diff {
  flex: 1; text-align: center; padding: 16rpx 10rpx; border-radius: 14rpx;
  background: #111827; border: 1rpx solid #22304a; color: #93a4bd; font-size: 23rpx;
}
.mode.active, .diff.active { background: #1f2a1f; border-color: #5bd9be; color: #5bd9be; font-weight: 700; }

.status { display: flex; justify-content: space-between; margin-top: 24rpx; color: #c7d2e5; font-size: 25rpx; }
.tries { color: #f0a33a; font-family: Consolas, monospace; }

.slots { display: flex; gap: 14rpx; justify-content: center; margin-top: 22rpx; }
.slot {
  width: 120rpx; height: 132rpx; border-radius: 16rpx; background: #0f172a; border: 1rpx solid #2a3a56;
  display: flex; align-items: center; justify-content: center; color: #66748b;
  font-family: Consolas, monospace; font-size: 56rpx;
}
.slot.filled { color: #fff; border-color: #5bd9be; background: #10231f; }

.keypad { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.key {
  width: calc(33.333% - 8rpx); height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 14rpx; background: #111827; border: 1rpx solid #2a3a56; color: #e8edf7;
  font-family: Consolas, monospace; font-size: 34rpx;
}
.key.go { background: #f0a33a; border-color: #f0a33a; color: #111827; font-family: inherit; font-size: 27rpx; font-weight: 700; }

.actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.actions .btn-primary, .actions .btn-ghost { flex: 1; }

.hint {
  margin-top: 20rpx; padding: 18rpx; border-radius: 14rpx;
  background: rgba(96,165,250,.08); border-left: 4rpx solid #60a5fa; color: #c7d2e5; font-size: 24rpx; line-height: 1.7;
}
.answer { margin-top: 22rpx; text-align: center; }
.answer-label { display: block; color: #7e8aa3; font-size: 22rpx; }
.answer-num { display: block; color: #5bd9be; font-family: Consolas, monospace; font-size: 52rpx; letter-spacing: 8rpx; margin-top: 6rpx; }

.history { margin-top: 24rpx; background: #111827; border: 1rpx solid #22304a; border-radius: 18rpx; padding: 18rpx 22rpx; }
.history-title { color: #7e8aa3; font-size: 22rpx; margin-bottom: 8rpx; }
.history-row { display: flex; justify-content: space-between; padding: 10rpx 0; border-top: 1rpx solid #1f2a3a; }
.guess { color: #e8edf7; font-family: Consolas, monospace; font-size: 28rpx; letter-spacing: 4rpx; }
.fb { color: #f0a33a; font-size: 24rpx; }

.rule { margin-top: 26rpx; padding: 24rpx; background: #111827; border: 1rpx solid #22304a; border-radius: 20rpx; }
.rule-title { color: #f0a33a; font-size: 26rpx; font-weight: 700; }
.rule-text { color: #8d9ab3; font-size: 24rpx; line-height: 1.8; margin-top: 10rpx; }
