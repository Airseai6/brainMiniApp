@import "../../styles/game.wxss";

.pile {
  background: #111827;
  border: 1rpx solid #22304a;
  border-radius: 18rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.pile-head { display: flex; justify-content: space-between; align-items: center; }
.pile-label { color: #93a4bd; font-size: 22rpx; }
.pile-count { color: #f0a33a; font-size: 34rpx; font-weight: 800; font-family: Consolas, monospace; }

.stones { display: flex; flex-wrap: wrap; gap: 8rpx; min-height: 36rpx; margin-top: 12rpx; align-items: center; }
.stone { width: 28rpx; height: 28rpx; border-radius: 50%; background: #f0a33a; box-shadow: 0 0 8rpx rgba(240, 163, 58, .25); }
.empty { color: #4b5a70; font-size: 22rpx; }

.take-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.take {
  min-width: 74rpx;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: #182235;
  border: 1rpx solid #2a3a56;
  color: #d7e0f0;
  font-size: 22rpx;
}
