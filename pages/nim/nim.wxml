<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 04</text>
    <text class="title-badge">零和博弈</text>
  </view>
  <view class="title-row">
    <text class="game-title">最后一颗</text>
    <text class="title-badge">Nim</text>
  </view>
  <view class="game-lead">三堆石子，轮流从任意一堆拿走至少一颗。普通模式拿最后一颗者赢；「取最后者输」反过来。</view>

  <game-rules text="三堆石子，轮流从一堆拿走至少一颗。普通模式拿最后一颗赢；“取最后者输”模式拿最后一颗输。" example="点堆和数量，再点拿取；AI 会立刻回应。"></game-rules>

  <view class="seg-row">
    <view class="seg warm {{mode === 'normal' ? 'active' : ''}}" data-mode="normal" bindtap="setMode">普通模式</view>
    <view class="seg warm {{mode === 'misere' ? 'active' : ''}}" data-mode="misere" bindtap="setMode">取最后者输</view>
  </view>

  <view class="status-line">
    <text class="status-strong">{{winner ? winner : (thinking ? 'AI 思考中…' : '轮到你')}}</text>
    <text class="mono">{{lastMove}}</text>
  </view>

  <view class="pile" wx:for="{{piles}}" wx:key="label" wx:for-item="p" wx:for-index="pi">
    <view class="pile-head">
      <text class="pile-label">堆 {{p.label}}</text>
      <text class="pile-count">{{p.count}}</text>
    </view>
    <view class="stones">
      <view class="stone" wx:for="{{p.stones}}" wx:key="index"></view>
      <text wx:if="{{p.count === 0}}" class="empty">空</text>
    </view>
    <view class="take-row">
      <view class="take" wx:for="{{p.options}}" wx:key="index" wx:for-item="n" data-pile="{{pi}}" data-count="{{n}}" bindtap="take" wx:if="{{!thinking && !winner}}" hover-class="press">拿 {{n}}</view>
    </view>
  </view>

  <view wx:if="{{winner === '你赢了'}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 你赢了 AI</text>
      <text class="win-sub">把对手留在必败态</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-primary" bindtap="newGame">新的 AI 对局</view>
    <view class="btn-ghost" bindtap="showHint">看提示</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>

  


  <game-learn concept="博弈论与异或" summary="把每堆数量写成二进制做异或（按位比较，相同为 0、不同为 1）。异或和为 0 的局面留给对手，就是必败态。"></game-learn>
</view>
