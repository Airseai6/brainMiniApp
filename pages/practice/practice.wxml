<view class="container">
  <view class="kicker">DAILY · {{dateStr}}</view>
  <view class="title">每日一练</view>
  <view class="subtitle">每天 3 个可重复玩的关卡，按当天日期固定；不排名，不刷题。完成一个算一个。</view>

  <view class="progress">
    <text class="progress-num">{{doneCount}}/{{items.length}}</text>
    <text class="progress-label">{{allDone ? '今天完成了' : '今天已练'}}</text>
  </view>

  <view wx:if="{{allDone}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 今天的三关完成了</text>
      <text class="win-sub">连续天数只存本地，明天再来。</text>
    </view>
  </view>

  <view class="tasks">
    <view class="task {{item.done ? 'done' : ''}}" wx:for="{{items}}" wx:key="key" data-key="{{item.key}}" bindtap="openItem">
      <text class="task-emoji">{{item.emoji}}</text>
      <view class="task-main">
        <text class="task-name">{{item.name}}</text>
        <text class="task-tag">{{item.tag}} · {{item.done ? '已完成' : '去练习'}}</text>
      </view>
      <text class="task-arrow">{{item.done ? '✓' : '›'}}</text>
    </view>
  </view>

  <view class="random-card" bindtap="openRandom">
    <view class="random-title">随机体验</view>
    <view class="random-desc">不想按顺序？从可重复玩的关卡里随机抽一个。</view>
    <view class="random-btn">随机一关 →</view>
  </view>

  <view class="rule">
    <view class="rule-title">为什么要每日一练</view>
    <view class="rule-text">每天 3 分钟，比周末一次刷 30 分钟更容易形成习惯。连续天数只存本地，不采集个人信息。</view>
  </view>
</view>
