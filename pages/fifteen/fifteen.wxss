@import "../../styles/game.wxss";

.board {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  width: 100%;
  max-width: 600rpx;
  margin: 16rpx auto 0;
}

.board.s4 { grid-template-columns: repeat(4, 1fr); max-width: 620rpx; }
.board.s4 .tile { font-size: 40rpx; border-radius: 10rpx; }

.tile {
  aspect-ratio: 1 / 1;
  border-radius: 16rpx;
  background: #111827;
  border: 2rpx solid #2a3a56;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  font-family: Consolas, monospace;
}

.tile.blank { background: transparent; border-style: dashed; border-color: #22304a; }
.tile.last { border-color: #5bd9be; background: #10231f; }
