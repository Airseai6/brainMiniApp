@import "../../styles/game.wxss";

.energy-panel {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #111827;
  border: 1rpx solid #22304a;
}
.energy-row {
  display: flex;
  justify-content: space-between;
  color: #93a4bd;
  font-size: 20rpx;
}
.energy-value { color: #5bd9be; font-family: Consolas, monospace; }
.energy-track {
  height: 12rpx;
  margin-top: 8rpx;
  border-radius: 99rpx;
  background: #1b2638;
  overflow: hidden;
}
.energy-fill {
  height: 100%;
  border-radius: 99rpx;
  background: linear-gradient(90deg, #f0a33a, #5bd9be);
  transition: width .2s ease;
}
.energy-meta { margin-top: 7rpx; color: #6b7a91; font-size: 18rpx; }

.board {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  width: 100%;
  max-width: 620rpx;
  margin: 10rpx auto 0;
  touch-action: none;
}

.swipe-tip {
  color: #7e8aa3;
  font-size: 20rpx;
  text-align: center;
  margin-top: 8rpx;
}

.cell {
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  background: #111827;
  border: 1rpx solid #22304a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cell-label { color: #ffffff; font-size: 30rpx; font-weight: 800; }
.cell-name { color: #7e8aa3; font-size: 16rpx; margin-top: 2rpx; }
.cell-1 { background: #132b3a; border-color: #28516b; }
.cell-2 { background: #16392f; border-color: #2f7d5b; }
.cell-3 { background: #3a2d16; border-color: #8a6a28; }
.cell-4 { background: #3a1e16; border-color: #9b4a2f; }
.cell-5 { background: #2a1c3a; border-color: #6f4aa8; }
.cell-6 { background: #3a1627; border-color: #a83f6b; }

.pad { margin-top: 16rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.pad-row { display: flex; gap: 8rpx; }
.pad-btn {
  width: 112rpx;
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #182235;
  border: 1rpx solid #2a3a56;
  color: #e8edf7;
  font-size: 32rpx;
}
.pad-btn.up { width: 112rpx; }
