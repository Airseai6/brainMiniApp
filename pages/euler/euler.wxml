<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 13</text>
    <text class="title-badge">图论</text>
  </view>
  <view class="title-row">
    <text class="game-title">一笔画</text>
    <text class="title-badge">七桥突围</text>
  </view>
  <view class="game-lead">每条边只走一次，能不能把所有边一次走完？先数每个点连了几条边。</view>

  <view class="seg-row">
    <view class="seg warm {{level.id === 'ring' ? 'active' : ''}}" data-id="ring" bindtap="setLevel">折线环</view>
    <view class="seg warm {{level.id === 'bridges' ? 'active' : ''}}" data-id="bridges" bindtap="setLevel">七桥</view>
  </view>

  <view class="status-line">
    <text class="status-strong">{{status}}</text>
    <text class="mono">已走 {{usedCount}}/{{edgeCount}}</text>
  </view>

  <view class="graph">
    <view class="edge {{item.used ? 'used' : ''}}" wx:for="{{edges}}" wx:key="index" style="{{item.style}}" data-index="{{index}}" bindtap="tapEdge" hover-class="press"></view>
    <view class="node {{item.current ? 'current' : ''}} {{item.start ? 'start' : ''}}" wx:for="{{nodes}}" wx:key="id" style="{{item.style}}" data-index="{{index}}" bindtap="tapNode" hover-class="press">{{item.label}}</view>
  </view>

  <view wx:if="{{usedCount === edgeCount && edgeCount > 0}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 一笔画完成</text>
      <text class="win-sub">所有边走了一次</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-ghost" bindtap="validate">检查欧拉条件</view>
    <view class="btn-ghost" bindtap="undo">撤销</view>
    <view class="btn-ghost" bindtap="reset">重来</view>
  </view>
  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>

  <game-rules title="能学到什么 · 欧拉路径与奇偶度" text="奇度点有 0 个或 2 个，才可能一笔画走完；超过 2 个，无论怎么试都走不通。柯尼斯堡七桥有四个奇度点。" example="七桥图有 **4 个奇度点**，超过 2 个，所以怎么走都会剩边。" tip="（没看懂没关系，上手玩一下就会了）"></game-rules>
</view>
