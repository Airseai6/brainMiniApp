<view class="container game-page">
  <view class="topline">
    <text class="game-kicker">思维闯关 · 06</text>
    <text class="title-badge">状态图</text>
  </view>
  <view class="title-row">
    <text class="game-title">过河</text>
    <text class="title-badge">7 步</text>
  </view>
  <view class="game-lead">狼、羊、菜都要到右岸。船每次只能带一样，农夫可以空船回来；你不在的一岸会出事。</view>

  <view class="seg-row">
    <view class="seg warm active">狼 · 羊 · 菜（入门）</view>
    <view class="seg" bindtap="openMC">传教士 · 野人（挑战）</view>
  </view>

  <view class="status-line">
    <text class="status-strong">{{status}}</text>
    <text class="mono">第 {{state.moves}} 步</text>
  </view>

  <view class="river-board">
    <view class="bank-card">
      <view class="bank-head"><text>出发岸</text><text class="bank-count">{{left.length}}/3</text></view>
      <view class="bank-items">
        <view class="item-card" wx:for="{{left}}" wx:key="id"><text class="emoji">{{item.icon}}</text><text>{{item.label}}</text></view>
        <view wx:if="{{left.length === 0}}" class="bank-empty">空</view>
      </view>
    </view>

    <view class="boat-center">
      <text class="boat-icon">⛵</text>
      <text class="boat-side">{{boatSide === 'left' ? '左岸' : '右岸'}}</text>
      <text class="boat-passenger">{{selectedLabel || '未选乘客'}}</text>
    </view>

    <view class="bank-card">
      <view class="bank-head"><text>目标岸</text><text class="bank-count">{{right.length}}/3</text></view>
      <view class="bank-items">
        <view class="item-card" wx:for="{{right}}" wx:key="id"><text class="emoji">{{item.icon}}</text><text>{{item.label}}</text></view>
        <view wx:if="{{right.length === 0}}" class="bank-empty">空</view>
      </view>
    </view>
  </view>

  <view class="pick-section">
    <view class="pick-head">选择船上带谁（先点选，再开船）</view>
    <view class="pick-row">
      <view class="pick {{selectedItem === item.id ? 'selected' : ''}}" wx:for="{{left}}" wx:key="id" data-id="{{item.id}}" bindtap="selectItem" wx:if="{{boatSide === 'left'}}" hover-class="press">
        <text>{{item.icon}}</text><text>{{item.label}}</text>
      </view>
      <view class="pick {{selectedItem === item.id ? 'selected' : ''}}" wx:for="{{right}}" wx:key="id" data-id="{{item.id}}" bindtap="selectItem" wx:if="{{boatSide === 'right'}}" hover-class="press">
        <text>{{item.icon}}</text><text>{{item.label}}</text>
      </view>
      <view class="pick empty-pick {{selectedEmpty ? 'selected' : ''}}" bindtap="selectEmpty" hover-class="press">空船</view>
    </view>
  </view>

  <view wx:if="{{won}}" class="win-banner">
    <text class="win-icon">🎉</text>
    <view class="win-copy">
      <text class="win-title">🎉 全部过河！</text>
      <text class="win-sub">狼、羊、菜安全到达</text>
    </view>
  </view>

  <view class="actions-row">
    <view class="btn-primary" bindtap="crossSelected">开船 →</view>
    <view class="btn-ghost" bindtap="showHint">提示</view>
    <view class="btn-ghost" bindtap="reset">重来</view>
  </view>

  <view wx:if="{{hint}}" class="hint-box">{{hint}}</view>

  <view class="rule-box">
    <view class="rule-title">能学到什么 · 状态图与最短路</view>
    <view class="rule-text">把“左岸还剩什么 + 船在哪岸”看成一个状态，每次过河是一条边。最短路就是最少步数。</view>
  </view>
</view>
