:host {
  display: block;
  margin-top: auto;
}

.learn {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(240, 163, 58, .05), rgba(17, 24, 39, .35));
  border: 1rpx solid rgba(240, 163, 58, .18);
}

.learn-head {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.learn-icon { font-size: 24rpx; line-height: 1; }
.learn-title {
  color: #f0a33a;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.5;
}

.learn-summary {
  margin-top: 6rpx;
  padding-left: 12rpx;
  border-left: 3rpx solid rgba(240, 163, 58, .45);
  color: #b9c4d6;
  font-size: 21rpx;
  line-height: 1.7;
}
